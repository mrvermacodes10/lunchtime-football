# Dev/sandbox: SQLite file, zero setup, real persistence.
DATABASE_URL="file:./dev.db"

# Production on Vercel: use Vercel Postgres or Neon instead, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# and change the provider in prisma/schema.prisma from "sqlite" to "postgresql".

# Random long string used to sign admin session tokens.
SESSION_SECRET="change-this-in-production-to-a-long-random-string"

# Optional — used only by `npm run db:seed` to create the first admin user.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme123"
